{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/run.py\" --data \"${CLAUDE_PLUGIN_DATA}\" notify",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/run.py\" --data \"${CLAUDE_PLUGIN_DATA}\" approve",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
